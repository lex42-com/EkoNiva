   "source": [
    "import statsmodels.formula.api as smf\n",
    "\n",
    "def fit_nb_regression(good_df, ration_cols):\n",
    "\n",
    "    df = good_df.copy()\n",
    "\n",
    "    # Формируем формулу\n",
    "    formula = \"cow_metrit_per_day ~ \" + \" + \".join(ration_cols)\n",
    "\n",
    "    # NB2 модель\n",
    "    model = smf.glm(\n",
    "        formula=formula,\n",
    "        data=df,\n",
    "        family=sm.families.NegativeBinomial()\n",
    "    ).fit()\n",
    "\n",
    "    return model"
   ]
  },
