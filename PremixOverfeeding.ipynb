    "import statsmodels.api as sm\n",
    "import statsmodels.formula.api as smf\n",
    "\n",
    "# формируем формулу\n",
    "formula = \"cow_metrit ~ premix_only + premix_and_combifeed + no_premix_no_combifeed\"\n",
    "\n",
    "nb_model = smf.glm(\n",
    "    formula=formula,\n",
    "    data=merged,\n",
    "    family=sm.families.NegativeBinomial()\n",
    ").fit()\n",
    "\n",
    "print(nb_model.summary())"
   ]
