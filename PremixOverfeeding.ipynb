  {
   "cell_type": "code",
   "execution_count": 254,
   "id": "32cd7480",
   "metadata": {},
   "outputs": [],
   "source": [
    "def shift_year_month(ym: str):\n",
    "    y, m = map(int, ym.split('-'))\n",
    "    if m == 12:\n",
    "        return f\"{y+1}-01\"\n",
    "    else:\n",
    "        return f\"{y}-{m+1:02d}\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 255,
   "id": "7e44c2d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "ration_pivot['year_month_shifted'] = ration_pivot['year_month'].apply(shift_year_month)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 256,
   "id": "5d4f42a2",
   "metadata": {},
   "outputs": [],
   "source": [
    "merged_lag = ration_pivot.merge(\n",
    "    herd_metrics[['farm_name','year_month','cow_metrit']],\n",
    "    left_on=['farm_name','year_month_shifted'],\n",
    "    right_on=['farm_name','year_month'],\n",
    "    how='left'\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 257,
   "id": "486fcf8a",
   "metadata": {},
   "outputs": [],
   "source": [
    "merged_lag = merged_lag.drop(columns=['year_month_y'])\n",
    "merged_lag = merged_lag.rename(columns={'year_month_x': 'year_month'})"
   ]
  },
